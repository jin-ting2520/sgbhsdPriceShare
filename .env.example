# 复制为 .env 后按需修改；不提供 .env 时使用下列默认值。
# 注意：生产环境务必修改数据库密码。

# 宿主机访问端口
PORT=3000

# 生产环境启用 HTTPS 强制跳转（反向代理需传 X-Forwarded-Proto）
FORCE_HTTPS=0
# 反向代理信任范围；直连填 false
TRUST_PROXY=loopback,linklocal,uniquelocal

# 管理后台密码（必填；为空则 /admin 禁用）
ADMIN_PASSWORD=change-me-please
# 管理后台登录有效期（小时，默认 168 = 7 天）
ADMIN_TOKEN_HOURS=168

# MySQL（docker compose 内部服务）
MYSQL_ROOT_PASSWORD=sgbhsd_root
MYSQL_DATABASE=sgbhsd
MYSQL_USER=sgbhsd
MYSQL_PASSWORD=sgbhsd_pass

# 价格变更历史保留条数（每个区服维度裁剪）
HISTORY_LIMIT=20000

# 工具（三国冰河时代助手）SSO 共享密钥：必须与工具端 TOOL_SSO_SECRET 完全一致
# 未配置时仅开发环境回退到文档默认密钥并告警；生产环境不配置将拒绝所有工具 SSO 登录
TOOL_SSO_SECRET=
# 同一工具账号两次 game-ingest 的最小间隔（毫秒，默认 10000），防重试风暴
SSO_INGEST_MIN_INTERVAL_MS=10000
# [已废弃·保留仅为提示] SSO_INGEST_TARGET 自安全修复 F1 起不再生效：
# 工具同步永远只写当前 SSO 账号自身，绝不代写区服主账号；仅当该账号本身是主账号时才按主账号共享广播。
# 已有部署若在 .env 里保留了 SSO_INGEST_TARGET=master，可安全删除，无需设置。

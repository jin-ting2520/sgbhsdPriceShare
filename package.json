{
  "name": "sgbhsd-price-share",
  "version": "1.0.0",
  "private": true,
  "description": "三国冰河时代富甲天下跑商价格分享：游戏直连同步、实时协作、MySQL/Redis 与报表 (Node.js + Vue3 + Element Plus)",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test \"test/*.test.js\"",
    "test:smoke": "node server/scripts/smoke.js",
    "db:vacuum": "node server/scripts/vacuum.js",
    "db:migrate": "node server/scripts/migrate-to-mysql.js",
    "game:sync": "node server/scripts/game-sync.js"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "element-plus": "^2.9.0",
    "express": "^4.21.2",
    "mysql2": "^3.24.6",
    "node-cron": "^4.6.0",
    "redis": "^6.3.0",
    "vue": "^3.5.13",
    "ws": "^8.22.0",
    "xlsx": "^0.18.5"
  }
}
